Welcome to IndigiTech, a digital space dedicated to exploring the rich history, culture, and stories of Aboriginal Australia. Here, we delve into the traditions and perspectives of Aboriginal communities, bringing you closer to the world of Dreamtime stories, historical art, and practices that hold deep significance.";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1737180464;}s:7:"creator";s:15:"Minh Thu Nguyen";s:4:"user";s:13:"minhthunguyen";s:11:"last_change";a:9:{s:4:"date";i:1737180464;s:2:"ip";s:12:"202.7.251.37";s:4:"type";s:1:"C";s:2:"id";s:23:"user:minhthunguyen:home";s:4:"user";s:13:"minhthunguyen";s:3:"sum";s:7:"created";s:5:"extra";s:0:"";s:10:"sizechange";i:696;s:4:"mode";s:4:"page";}}}