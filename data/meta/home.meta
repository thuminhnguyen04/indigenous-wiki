IndigiTech acknowledges the peoples who are the traditional custodians of Australia and the Torres Strait Islands. We respect their spiritual relationship with their country, and that their cultural and heritage beliefs are still important to the living peoples today. We also pay respect to the cultural authority of Aboriginal and Torres Strait Islander peoples of Australia and pay respect to their Elders past, and present.";}s:8:"relation";a:3:{s:5:"media";a:4:{s:18:"aboriginalflag.jpg";b:1;s:17:"dsc0663_600x.webp";b:1;s:21:"languageshomepage.jpg";b:1;s:12:"ausindig.jpg";b:1;}s:10:"references";a:4:{s:19:"aboriginal_pedagogy";b:1;s:18:"aboriginal_seasons";b:1;s:19:"aboriginal_language";b:1;s:30:"history_of_aboriginals_symbols";b:1;}s:10:"firstimage";s:18:"aboriginalflag.jpg";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:0;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1737179849;s:8:"modified";i:1740309070;}s:7:"creator";s:15:"Minh Thu Nguyen";s:4:"user";s:13:"minhthunguyen";s:11:"last_change";a:9:{s:4:"date";i:1740309070;s:2:"ip";s:14:"203.123.64.226";s:4:"type";s:1:"E";s:2:"id";s:4:"home";s:4:"user";s:13:"minhthunguyen";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:-1;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:13:"minhthunguyen";s:15:"Minh Thu Nguyen";}}}