a:77:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:29:"8 Aboriginal Ways of Learning";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:46;}i:4;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:19:"Aboriginal Pedagogy";i:1;i:2;i:2;i:46;}i:2;i:46;}i:5;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:2;}i:2;i:46;}i:6;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:79;}i:7;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:17:"What is Pedagogy?";i:1;i:3;i:2;i:79;}i:2;i:79;}i:8;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:79;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:79;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:108:"Pedagogy refers to the methods and practices of teaching. It’s about how we help others learn effectively.";}i:2;i:107;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:215;}i:12;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:217;}i:13;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:33:"Importance of Indigenous Pedagogy";i:1;i:3;i:2;i:217;}i:2;i:217;}i:14;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:217;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:217;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:319:"Indigenous pedagogy is important because it incorporates traditional knowledge, culture, and respect for the environment. The goal is to make learning meaningful and connected to real life. Indigenous pedagogy focuses on community, relationships, and learning from the land, making education more engaging and holistic.";}i:2;i:261;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:580;}i:18;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:580;}i:19;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:48:"Following are the 8 Aboriginal ways of learning.";}i:2;i:582;}i:20;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:630;}i:21;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:632;}i:22;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:29:"8 Ways of Aboriginal Learning";i:1;i:2;i:2;i:632;}i:2;i:632;}i:23;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:2;}i:2;i:632;}i:24;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:632;}i:25;a:3:{i:0;s:13:"internalmedia";i:1;a:7:{i:0;s:11:":8_ways.jpg";i:1;s:0:"";i:2;s:6:"center";i:3;s:3:"400";i:4;N;i:5;s:5:"cache";i:6;s:7:"details";}i:2;i:675;}i:26;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:697;}i:27;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:699;}i:28;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:16:"1. Story Sharing";i:1;i:3;i:2;i:699;}i:2;i:699;}i:29;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:699;}i:30;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:699;}i:31;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:414:"Story Sharing is a key part of Indigenous learning. Through storytelling, knowledge is passed down from one generation to the next. This approach makes learning personal and emotional. It helps people connect with the lessons on a deeper level, making the information memorable and easier to understand. Storytelling engages the imagination, allowing learners to picture and grasp complex ideas in a relatable way.";}i:2;i:726;}i:32;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1140;}i:33;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1142;}i:34;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:16:"2. Learning Maps";i:1;i:3;i:2;i:1142;}i:2;i:1142;}i:35;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:1142;}i:36;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1142;}i:37;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:400:"Learning Maps are visual tools that help us organize information and see how different ideas connect. This method helps students understand the bigger picture and see relationships between concepts. By creating maps, learners can visually structure their thoughts and make sense of complicated topics. It’s a way to break down knowledge into manageable pieces, making it easier to remember and use.";}i:2;i:1169;}i:38;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1569;}i:39;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1571;}i:40;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:22:"3. Non-verbal Learning";i:1;i:3;i:2;i:1571;}i:2;i:1571;}i:41;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:1571;}i:42;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1571;}i:43;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:434:"Non-verbal Learning involves communicating and understanding through actions, gestures, and expressions rather than words. In this method, learning happens through observation, movement, and experience. It’s important because not all knowledge is shared through language. Non-verbal learning can be especially effective in activities that require physical demonstration or artistic expression, where words alone might not be enough.";}i:2;i:1604;}i:44;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:2038;}i:45;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:2040;}i:46;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:21:"4. Symbols and Images";i:1;i:3;i:2;i:2040;}i:2;i:2040;}i:47;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:2040;}i:48;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:2040;}i:49;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:379:"Symbols and Images are powerful tools in Indigenous pedagogy. They help represent complex ideas in a simple way. Symbols can communicate deeper meanings quickly and effectively, allowing learners to grasp big ideas without needing detailed explanations. Images and symbols can make abstract concepts more concrete, helping learners visualize and remember information more easily.";}i:2;i:2072;}i:50;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:2451;}i:51;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:2453;}i:52;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:13:"5. Land Links";i:1;i:3;i:2;i:2453;}i:2;i:2453;}i:53;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:2453;}i:54;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:2453;}i:55;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:459:"The land is a teacher. Land Links focus on connecting learning to the environment. This method emphasizes the importance of the natural world as a teacher. Learning is grounded in the land, which provides knowledge about seasons, weather, plants, and animals. By understanding the land, learners develop a deeper connection to their surroundings and learn how to live in harmony with the environment. It also helps make lessons more relevant to everyday life.";}i:2;i:2477;}i:56;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:2936;}i:57;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:2938;}i:58;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:22:"6. Non-linear Learning";i:1;i:3;i:2;i:2938;}i:2;i:2938;}i:59;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:2938;}i:60;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:2938;}i:61;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:507:"Learning doesn’t follow a straight line. Non-linear Learning is based on the idea that learning doesn’t always follow a straight path. Instead of progressing from one step to the next in a fixed order, this approach allows learners to explore topics at their own pace. They may revisit ideas, skip around, or focus on different parts at different times. This flexibility encourages a more personalized and in-depth learning experience, as students can absorb information in ways that work best for them.";}i:2;i:2971;}i:62;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:3478;}i:63;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:3480;}i:64;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:26:"7. Deconstruct/Reconstruct";i:1;i:3;i:2;i:3480;}i:2;i:3480;}i:65;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:3480;}i:66;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:3480;}i:67;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:390:"Deconstruct/Reconstruct involves breaking down concepts or ideas to understand them better, then putting them back together. This process allows learners to see how something works from the inside out. By taking something apart, students gain a deeper understanding of its components. Afterward, they can reconstruct the idea, sometimes in a new way, allowing for creativity and innovation.";}i:2;i:3517;}i:68;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:3907;}i:69;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:3909;}i:70;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:18:"8. Community Links";i:1;i:3;i:2;i:3909;}i:2;i:3909;}i:71;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:3;}i:2;i:3909;}i:72;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:3909;}i:73;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:611:"Community Links emphasize the importance of learning from the people around you. Learning happens within the community. Elders pass down traditions through ceremonies, ensuring that cultural knowledge is preserved across generations. This method integrates the knowledge and experience of community members, family, and elders into the learning process. It values the wisdom passed down through generations and recognizes that learning happens not only in the classroom but also in everyday life. Involving the community in education helps create a strong connection between learning and real-world experiences.";}i:2;i:3938;}i:74;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:4549;}i:75;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:4550;}i:76;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:4550;}}